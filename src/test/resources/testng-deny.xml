<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HADIR Admin Automation Suite - Tester Deny (238 TCs: 173 Web UI + 65 REST API)" verbose="1">

    <listeners>
        <listener class-name="com.juaracoding.magang.listeners.TestListener" />
    </listeners>

    <parameter name="browser" value="chrome" />
    <parameter name="headless" value="true" />

    <test name="Tester Deny - Admin Web UI (173 TCs)">
        <classes>
            <class name="com.juaracoding.magang.tests.admin.deny.AdminLoginTest" />
            <class name="com.juaracoding.magang.tests.admin.deny.AdminReportsGroupATest" />
            <class name="com.juaracoding.magang.tests.admin.deny.AdminImportTest" />
            <class name="com.juaracoding.magang.tests.admin.deny.AdminManagementGroupATest" />
            <class name="com.juaracoding.magang.tests.admin.deny.AdminCrossModuleDenyE2ETest" />
        </classes>
    </test>

    <test name="Tester Deny - Admin REST API Group A (65 TCs)">
        <classes>
            <class name="com.juaracoding.magang.api.admin.AdminGroupAApiTest" />
        </classes>
    </test>

</suite>

