<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HADIR Admin Negative Test Suite" verbose="1">

    <listeners>
        <listener class-name="com.juaracoding.magang.listeners.TestListener" />
    </listeners>

    <parameter name="browser" value="chrome" />
    <parameter name="headless" value="true" />

    <test name="Negative Scenarios">
        <groups>
            <run>
                <include name="negative" />
            </run>
        </groups>
        <classes>
            <class name="com.juaracoding.magang.tests.admin.deny.AdminLoginTest" />
            <class name="com.juaracoding.magang.tests.admin.aji.AdminDashboardTest" />
            <class name="com.juaracoding.magang.tests.admin.deny.AdminReportsGroupATest" />
            <class name="com.juaracoding.magang.tests.admin.deny.AdminImportTest" />
        </classes>
    </test>

</suite>

